# --- required on Railway -------------------------------------------------------
# Where the SQLite DB, session secret and MQTT TLS cert live. Mount a volume here.
DATA_DIR=/data
# People need this to create an account. Leave empty only for local testing.
HUB_INVITE_CODE=change-me

# --- usually automatic on Railway ----------------------------------------------
# PORT                       HTTP port (Railway sets it)
# RAILWAY_PUBLIC_DOMAIN      used for the hub URL if PUBLIC_URL is unset
# RAILWAY_TCP_PROXY_DOMAIN   used for the device MQTT host if MQTT_PUBLIC_HOST is unset
# RAILWAY_TCP_PROXY_PORT     used for the device MQTT port if MQTT_PUBLIC_PORT is unset

# --- optional ------------------------------------------------------------------
# Public https URL of the hub (baked into installers and sent to devices). No trailing slash.
# PUBLIC_URL=https://claude-desk.up.railway.app
# MQTT/TLS listen port inside the container (TCP Proxy target). Default 8883.
# MQTT_PORT=8883
# What devices should connect to (overrides the Railway TCP proxy values).
# MQTT_PUBLIC_HOST=roundhouse.proxy.rlwy.net
# MQTT_PUBLIC_PORT=12345
# Cookie signing secret. Generated and stored in DATA_DIR if unset.
# SESSION_SECRET=
# Bring your own broker cert (PEM; "\n" escapes allowed). Must be RSA-2048 for the ESP8266.
# Default: a self-signed RSA-2048 cert generated on first start and kept in DATA_DIR.
# MQTT_TLS_CERT=
# MQTT_TLS_KEY=
# Where install.sh / install.ps1 / hook.py / hook.ps1 are read from. Default: ../client
# CLIENT_DIR=
# Bind address. Default 0.0.0.0
# HOST=0.0.0.0
# Set to 1 to silence the startup log.
# HUB_QUIET=
