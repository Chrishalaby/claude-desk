    "aedes": "^1.2.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "selfsigned": "^5.5.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "mqtt": "^5.16.1"
  }
}
