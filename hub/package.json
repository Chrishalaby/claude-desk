{
  "name": "claude-desk-hub",
  "version": "1.0.0",
  "private": true,
  "description": "claude-desk hub: web app, REST API and MQTT/TLS broker for GeekMagic desk companions",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
